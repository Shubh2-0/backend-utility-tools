# Personal Instagram Account (NOT the brand account — keeps brand safe)
INSTAGRAM_USERNAME=your_personal_username
INSTAGRAM_PASSWORD=your_personal_password

# Google Authenticator 2FA — TOTP secret key (the text code from setup)
# Get it: Instagram → Settings → Password & Security → 2FA → Authentication app → Get new key
INSTAGRAM_TOTP_KEY=your_totp_secret_key_here

# Safety Limits (30/day = 10 morning + 10 afternoon + 10 evening)
MAX_COMMENTS_PER_DAY=30
COMMENTS_PER_SESSION=10
COMMENT_MIN_DELAY=180
COMMENT_MAX_DELAY=300

# Optional: Google Gemini API for dynamic AI comments
# Get a free key here: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback: Instagram Web Session ID (sessionid cookie) if password/IP login fails
INSTAGRAM_SESSIONID=your_sessionid_cookie_here

