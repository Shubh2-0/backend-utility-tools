# =====================================================================
# Central Automation Engine - Unified Master Environment Configuration
# =====================================================================
# Copy this file to '.env' in your local root and fill in your secrets.
# IMPORTANT: DO NOT commit the actual '.env' file to Git tracking.
# All variables here are strictly used for your local automation scripts.
# =====================================================================

# 1. GitHub Integration & Open-Source Contributor Bot
GH_TOKEN=your_github_personal_access_token_here

# 2. Tech Content & Blog Auto-Publishing (Dev.to, Hashnode, OpenAI)
DEVTO_API_KEY=your_devto_api_key_here
HASHNODE_TOKEN=your_hashnode_personal_access_token
HASHNODE_PUBLICATION_ID=your_hashnode_publication_id
GEMINI_API_KEY=your_google_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# 3. Job Portal Automated Profile Updater (Naukri, Shine, Foundit)
NAUKRI_USERNAME=your_naukri_email_or_username
NAUKRI_PASSWORD=your_naukri_password
SHINE_USERNAME=your_shine_email_or_username
SHINE_PASSWORD=your_shine_password
FOUNDIT_USERNAME=your_foundit_email_or_username
FOUNDIT_PASSWORD=your_foundit_password

# 4. SMTP Email Notifications & Daily Digest Alerts
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_16_digit_app_password
EMAIL_TO=your_recipient_email@gmail.com
