# At least ONE of (Telegram) or (WhatsApp) must be configured.
# If both, alerts go to both channels.

# Telegram Bot (recommended — reliable, free)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp via CallMeBot (free, sometimes flaky)
WHATSAPP_PHONE=
CALLMEBOT_API_KEY=

# Search config
SEARCH_KEYWORD=Java
EXPERIENCE=3
MAX_ALERTS_PER_RUN=10
